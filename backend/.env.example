# Copy this file to .env and fill in real values. Never commit .env.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"

APP_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=

# Optional. Defaults to SQLite in backend/instance/asce.db
# DATABASE_URL=sqlite:///asce.db

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Google Gemini key for the AI estimate (https://aistudio.google.com/apikey).
# Leave empty to use manual job selection only.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
